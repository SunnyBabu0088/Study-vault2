# Frontend Environment Configuration (.env.example)
# Copy to .env or .env.local to customize frontend settings

# Leave empty for standard web browser mode (uses relative /api routes)
# Or provide the full backend URL (e.g. http://10.0.2.2:5000 for Android emulator)
VITE_API_BASE_URL=

# Backend target URL for Vite dev proxy
VITE_PROXY_TARGET=http://localhost:5000
