# ==========================================
# StudyVault Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=studyvault
POSTGRES_PORT=5432

# Backend Service Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres_secure_password@db:5432/studyvault
DATABASE_SSL=false
JWT_SECRET=studyvault_jwt_secret_change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=studyvault_jwt_refresh_secret_change_me_in_production
FRONTEND_URL=http://localhost:5500
COOKIE_SECURE=false
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# Frontend Configuration
# Leave blank for standard web deployment (uses Nginx / Vite proxy for /api)
VITE_API_BASE_URL=
# Proxy target for Vite dev server inside Docker
VITE_PROXY_TARGET=http://backend:5000
